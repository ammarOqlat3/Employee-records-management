@model EmployeeViewModel
@{
    ViewData["Title"] = "all employee";

}
<div class="p-4 container">
    <div class="row p-4">
        <div class="col-md-12">
            <h3>Add new employee</h3>

        </div>

    </div>
    <div class="row p-4">
        <div class=" col-md-6">
            <form asp-controller="Employee" asp-action="Add" method="post">
                <div class="nb-3">
                    <label for="FirstName" class="form-label fw-bold">First Name</label>
                    <input asp-for="FirstName" type="text" class="form-control" />
                    <span asp-validation-for="FirstName"></span>
                </div>

                <div class="nb-3">
                    <label for="LastName" class="form-label fw-bold">Last Name</label>
                    <input asp-for="LastName" type="text" class="form-control" />
                    <span asp-validation-for="LastName"></span>

                </div>

                <div class="nb-3">
                    <label for="datetimepicker" class="form-label fw-bold">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth"></span>

                </div>

                <div class="nb-3">
                    <label for="dateGendertimepicker" class="form-label fw-bold">Gender</label>
                    <div class="d-flex">
                        <div class="form-check px-4">
                            <input asp-for="Gender" class="form-check-input" value="male" type="radio" />
                            <label class="form-check-label fw-bold"for="Gender">Male</label> 
                        </div>
                        <div class="form-check px-4">
                            <input asp-for="Gender" class="form-check-input" value="female" type="radio"  />
                            <label class="form-check-label fw-bold" for="Gender">Female</label>
                        </div>
                    </div>
                    <span asp-validation-for="Gender"></span>

                </div>
                <div class="nb-3">
                    <label for="email" class="form-label fw-bold">email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email"></span>

                </div>

                <div class="nb-3">
                    <label for="phoneNumber" class="form-label fw-bold">Phone Number</label>
                    <input asp-for="PhoneNumber" type="number" class="form-control" />
                    <span asp-validation-for="PhoneNumber"></span>

                </div>

                <div class="nb-3">
                    <label for="Address" class="form-label fw-bold">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Address"></span>

                </div>
                <br />
                <div class="nb-3">
                    <label  class="form-label fw-bold">please chose department</label>
                    <select asp-for="DepartmentId"
                            asp-items="ViewBag.departments"
                            class="form-control">
                        <option value="">-- Select Department --</option>
                    </select>
                </div>
                <div class="nb-3">
                    <div class="form-check">

                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActive" checked />
                        <label class="form-check-label fw-bold "for="isActive">Mark as Active</label>
                        <span asp-validation-for="IsActive"></span>

                    </div>
                    
                </div>
                <button type="submit"class="btn btn-dark">Sumbit</button>




            </form>

        </div>

    </div>

</div>