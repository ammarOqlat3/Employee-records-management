@model PaginatedList<EmployeeViewModel>
@{
    ViewData["Title"] = "Employees";
    var activeCount = Model.Items.Count(e => e.IsActive);
    var inactiveCount = Model.Items.Count - activeCount;
}

<section class="page-hero">
    <div>
        <span class="eyebrow">People Directory</span>
        <h2>Employee records that are easy to scan.</h2>
        <p>Search employees, sort by name, birth date, or activity status, and keep profile actions close without crowding the page.</p>
        <div class="hero-actions">
            <a asp-controller="Employee" asp-action="Add" class="btn btn-primary">
                <i class="bi bi-person-plus"></i>
                Add Employee
            </a>
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-clockwise"></i>
                Reset List
            </a>
        </div>
    </div>
    <div class="hero-metric">
        <div>
            <span class="metric-number">@Model.TotalItems</span>
            <span class="metric-label">total employee records</span>
        </div>
        <p class="mb-0">Page @Model.PageIndex of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</p>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card">
        <span class="stat-icon"><i class="bi bi-people"></i></span>
        <div>
            <strong>@Model.Items.Count</strong>
            <span>Visible on this page</span>
        </div>
    </div>
    <div class="stat-card">
        <span class="stat-icon"><i class="bi bi-check-circle"></i></span>
        <div>
            <strong>@activeCount</strong>
            <span>Active here</span>
        </div>
    </div>
    <div class="stat-card">
        <span class="stat-icon"><i class="bi bi-pause-circle"></i></span>
        <div>
            <strong>@inactiveCount</strong>
            <span>Inactive here</span>
        </div>
    </div>
    <div class="stat-card">
        <span class="stat-icon"><i class="bi bi-layers"></i></span>
        <div>
            <strong>@Model.PageSize</strong>
            <span>Records per page</span>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Directory</span>
            <h3 class="panel-title">All employees</h3>
        </div>
        <div class="section-actions">
            <a asp-controller="Employee" asp-action="Add" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Employee
            </a>
        </div>
    </div>

    <div class="toolbar">
        <form class="search-form" asp-action="Index" method="get">
            <input name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" type="search" placeholder="Search by first or last name" aria-label="Search employees" />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i>
                Search
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-list-ul"></i>
            Full List
        </a>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Employee</th>
                    <th scope="col">
                        <a asp-controller="Employee" asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Name</a>
                    </th>
                    <th scope="col">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["DateOfBirthSortParm"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Birth date</a>
                    </th>
                    <th scope="col">Gender</th>
                    <th scope="col">Department</th>
                    <th scope="col">Contact</th>
                    <th scope="col">Address</th>
                    <th scope="col">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IsActiveSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Status</a>
                    </th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                            <td colspan="9">
                            <div class="empty-state">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No employees found. Try another search or add a new employee.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var employee in Model.Items)
                    {
                        var initial = string.IsNullOrWhiteSpace(employee.FirstName) ? "E" : employee.FirstName.Substring(0, 1).ToUpper();
                        <tr>
                            <th scope="row">#@employee.EmployeeId</th>
                            <td>
                                <div class="person-cell">
                                    <span class="avatar">@initial</span>
                                    <div>
                                        <strong>@employee.FirstName @employee.LastName</strong>
                                        <span class="subtext">@employee.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td>@employee.DateOfBirth.ToString("MMM dd, yyyy")</td>
                            <td>@employee.Gender</td>
                            <td>
                                <span class="department-pill">
                                    <i class="bi bi-building"></i>
                                    @(string.IsNullOrWhiteSpace(employee.DepartmentName) ? "Unassigned" : employee.DepartmentName)
                                </span>
                            </td>
                            <td>
                                <span>@employee.PhoneNumber</span>
                                <span class="subtext">@employee.Email</span>
                            </td>
                            <td>@employee.Address</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="status-pill status-active"><i class="bi bi-check2-circle"></i> Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-inactive"><i class="bi bi-x-circle"></i> Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-outline-dark btn-icon" asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.EmployeeId" aria-label="Edit employee">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn btn-danger btn-icon" asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.EmployeeId" aria-label="Delete employee" onclick="return confirm('Are you sure you want to delete this employee?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Employee pagination">
            <ul class="pagination justify-content-end flex-wrap">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="1" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">First</a>
                </li>
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                        <a class="page-link" asp-route-pageNumber="@i" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Next</a>
                </li>
                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="@Model.TotalPages" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Last</a>
                </li>
            </ul>
        </nav>
    }
</section>
