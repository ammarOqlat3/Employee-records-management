<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <span class="brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>
                <span>
                    <strong>PeopleOps</strong>
                    <small>Employee Records</small>
                </span>
            </a>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <a asp-controller="Home" asp-action="Index" class="nav-link">
                    <i class="bi bi-house-door"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Employee" asp-action="Index" class="nav-link">
                    <i class="bi bi-people"></i>
                    <span>Employees</span>
                </a>
                <a asp-controller="Employee" asp-action="Add" class="nav-link">
                    <i class="bi bi-person-plus"></i>
                    <span>Add Employee</span>
                </a>
                <a asp-controller="Department" asp-action="Index" class="nav-link">
                    <i class="bi bi-building"></i>
                    <span>Departments</span>
                </a>
                <a asp-controller="Department" asp-action="Add" class="nav-link">
                    <i class="bi bi-plus-square"></i>
                    <span>Add Department</span>
                </a>
            </nav>

            <div class="sidebar-card">
                <span class="eyebrow">Quick tip</span>
                <p>Keep employee profiles updated so reports and team planning stay clean.</p>
            </div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div>
                    <span class="eyebrow">Management Console</span>
                    <h1>@(ViewData["Title"] ?? "Dashboard")</h1>
                </div>
                <div class="topbar-actions">
                    <a asp-controller="Employee" asp-action="Add" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i>
                        <span>New Employee</span>
                    </a>
                    <a asp-controller="Department" asp-action="Add" class="btn btn-light">
                        <i class="bi bi-building-add"></i>
                        <span>New Department</span>
                    </a>
                </div>
            </header>

            <section class="content-area">
                @RenderBody()
            </section>

            <footer class="app-footer">
                <div>
                    <strong>PeopleOps Studio</strong>
                    <span>Employee records management dashboard</span>
                </div>
                <span>&copy; @DateTime.Now.Year</span>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
