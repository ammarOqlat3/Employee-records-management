@using EmployeeRecordsManagement.ViewModels
@model DepartmentViewModel

@{
    ViewData["Title"] = "Add Department";
}

<section class="page-hero">
    <div>
        <span class="eyebrow">New Department</span>
        <h2>Create a team home.</h2>
        <p>Add departments that make employee records easier to filter, maintain, and understand across the organization.</p>
    </div>
    <div class="hero-metric">
        <div>
            <span class="metric-number"><i class="bi bi-building-add"></i></span>
            <span class="metric-label">department setup</span>
        </div>
        <p class="mb-0">A clear structure makes the employee directory stronger.</p>
    </div>
</section>

<section class="panel form-panel">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Department Form</span>
            <h3 class="panel-title">Department details</h3>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left"></i>
            Back to departments
        </a>
    </div>

    <form asp-controller="Department" asp-action="Add" method="post" class="form-grid">
        <div class="form-span-2">
            <label asp-for="Name" class="form-label">Department Name</label>
            <input asp-for="Name" type="text" class="form-control" placeholder="Example: Human Resources" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-span-2 section-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2"></i>
                Save Department
            </button>
            <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</section>
